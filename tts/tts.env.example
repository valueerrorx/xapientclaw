# Xapient TTS (KittenTTS) – Konfig. install.sh legt daraus /opt/kitten-tts/tts.env an (nie ueberschrieben).

# Standardstimme: Eleanor, Lena, Greta, Jonas, Felix, Martha, Serena, Iris, Grace, Edith, Diana, Otis, Vincent
KITTEN_VOICE=Eleanor

# Eigene Stimme: Style-Pack als .npy (float32 [510,256]), wird unter KITTEN_CUSTOM_NAME angeboten.
#KITTEN_CUSTOM_VOICE=/opt/kitten-tts/voices/eigene.npy
#KITTEN_CUSTOM_NAME=Eigene
#KITTEN_VOICE=Eigene

#KITTEN_THREADS=3
#KITTEN_SPEED=1.0
#TTS_PORT=8765

# Englische Woerter englisch aussprechen (mixphon), 0 = aus
#TTS_MIXPHON=0
