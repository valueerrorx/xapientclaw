# Xapient TTS – lokale Konfiguration.
# Beim Setup wird daraus ~/tts/.env erzeugt. Kann Secrets enthalten -> NICHT ins Git (chmod 600).

# Lokaler HTTP-Dienst (nur localhost):
TTS_HOST=127.0.0.1
TTS_PORT=8765

# Sprache + Standardstimme (weibliche Katalogstimme, keine Anmeldung noetig):
TTS_LANGUAGE=german
TTS_DEFAULT_VOICE=anna

# CPU-Threads (leer = nproc-1):
#TTS_THREADS=3

# OPTIONAL: nur fuer /stimme (eigene Stimme klonen). Dann hier einen HuggingFace-Token
# eintragen UND auf https://huggingface.co/kyutai/pocket-tts die Terms akzeptieren.
# Fuer die eingebauten Katalogstimmen (anna, mary, ...) ist das NICHT noetig.
#HF_TOKEN=
